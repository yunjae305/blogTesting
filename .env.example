PORT=
APP_ENV=
# 빌드된 프런트엔드 경로(기본 apps/web/dist). 개발 중에는 Vite가 서빙하므로 비워 둔다.
# WEB_DIR=

# --- 서버 발행 개선(docs/서버-발행-개선-계획.md) ---
# 네이버 발행 입력 모드. 비우면 auto(기본) — 합성 paste를 먼저 시도하고, 에디터가
# 거부하면 그 발행만 기존 클립보드 경로로 갈아탄다. 2026-08-19 실발행에서 스마트에디터
# ONE이 합성 paste를 받지 않는 것이 확인됐다(제목은 키 입력 폴백으로 들어가고 본문에서
# 실패). synthetic = 엄격(클립보드 절대 미사용, 거부 시 본문에서 중단) ·
# clipboard = 항상 기존 경로. 실험: scripts/probe_synthetic_paste.py.
# NAVER_PASTE_MODE=auto
# 발행 뒤 확인용으로 열어 둔 크롬을 몇 분 뒤에 닫을지. 0 이하면 정리 안 함.
# KEEP_OPEN_BROWSER_TTL_MINUTES=15
# 서버 전체 동시 발행 크롬 상한(예약 워커). RAM 32GB 미만이면 줄인다.
# SCHEDULED_MAX_CONCURRENT_PUBLISH=10

MONGODB_URI=

# 비워 두면 디스크 캐시로 돈다. 서버를 두 대 이상으로 늘릴 때만 채운다.
REDIS_URL=

# 실제 키. 이 파일은 커밋되지 않는다(.gitignore) — 커밋되는 .env.example은 값을 비운다.
# 키가 git 이력에 들어갔다면 커밋을 지우는 것으로는 부족하다. 즉시 재발급한다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 키워드 수집
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 모듈별 공급자(docs/adr/ADR-004). `mock`으로 두면 그 모듈만 목으로 돌린다.
M3_COLLECT_PROVIDER=gemini
M3_COLLECT_MODEL=gemini-3.6-flash
M3_SUMMARY_PROVIDER=gemini
M3_SUMMARY_MODEL=gemini-3.6-flash

M2_TOPIC_PROVIDER=anthropic
M2_TOPIC_MODEL=claude-opus-5

M4_DRAFT_PROVIDER=anthropic
M4_DRAFT_MODEL=claude-opus-5
M4_REVIEW_PROVIDER=openai
M4_REVIEW_MODEL=gpt-5.6-sol

M5_IMAGE_PROVIDER=openai
M5_IMAGE_MODEL=gpt-image-2

COST_MAX_TOKENS_PER_CALL=8000
COST_MAX_CALLS_PER_POST=30
COST_MAX_DAILY_USD_PER_USER=5
COST_MAX_DAILY_USD_TOTAL=50

# 이메일 저장 암호화 키 — 팀 전원이 같은 값을 쓰고, 절대 바꾸지 않는다.
# 바꾸면 기존 email_enc 복호화가 전부 실패한다. 방식은 modules/auth/email_crypto.py 참고.
EMAIL_ENC_KEY=
EMAIL_INDEX_KEY=